# Contact form mail. Read by `src/lib/mail.ts`, called from the POST handler at
# `src/app/api/contact/route.ts`.
#
# Gmail will not accept the account's own password over SMTP. Turn on 2-step
# verification for the account, then create an app password at
# https://myaccount.google.com/apppasswords and paste it below (16 characters,
# no spaces). Revoking it later takes one click on the same page.
#
# In production these live in Vercel → Project → Settings → Environment
# Variables. Locally, copy this file to `.env` — every `.env*` file except this
# example is git-ignored, so the password never reaches the repository.
#
# Without them the site still works: `/api/contact` answers that it has no
# sending account, and the form offers "send it from your mail client" instead.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=work.dibyanshumoura@gmail.com
SMTP_PASS=

# Optional — both default to `SMTP_USER` and to the address printed in the form's
# `to:` row (`site.links.email`), which for this site is the same mailbox.
# `MAIL_FROM` is what Gmail requires the authenticated account to be.
MAIL_FROM=
MAIL_TO=

# Last.fm widget. Read by `src/lib/lastfm.ts`, served from the GET handler at
# `src/app/api/now-playing/route.ts`.
#
# Create the key at https://www.last.fm/api/account/create — read-only calls
# need no shared secret, so nothing here is secret-critical. Keep the shared
# secret out of all files unless you ever write to the API.
#
# In production add the same names in Vercel → Project → Settings →
# Environment Variables. Without them the listening section says it is quiet.

LASTFM_API_KEY=
LASTFM_USER=
